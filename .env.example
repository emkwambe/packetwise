# PacketWise Configuration

# App
DEBUG=true

# Database — SQLite for local dev.
# Production: Supabase Postgres. Use the psycopg2 driver, NOT asyncpg — this
# application is synchronous (create_engine + sqlalchemy.orm.Session) and an
# asyncpg DSN fails at startup with "The asyncio extension requires an async
# driver to be used".
# Supabase -> Project Settings -> Database -> Connection string -> URI, then
# swap the scheme to postgresql+psycopg2:// and keep sslmode=require. Prefer
# the pooler host (port 6543) for containerised workloads.
DATABASE_URL=sqlite:///data/packetwise.db
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# OCR
# NOTE the spelling: TESSERACT_CMD. Settings rejects unknown keys, so a typo
# here (e.g. TESERACT_CMD) stops the application from starting at all.
TESSERACT_CMD=tesseract

# Auth
# API_KEY authenticates server-to-server callers (integration script, jobs).
# Browsers do NOT use it — they sign in with DASHBOARD_PASSWORD and hold a
# signed HttpOnly cookie instead. See docs/adr/ADR-004.
# Change all three before any deployment: the built-in defaults are public
# knowledge, and the app warns at startup if they survive with DEBUG off.
API_KEY=dev-key-change-in-production
DASHBOARD_PASSWORD=dev-password-change-in-production
# Signs session cookies. Rotating it signs every operator out immediately.
SESSION_SECRET=dev-secret-change-in-production
SESSION_TTL_HOURS=12

# Origins allowed to call the API with credentials. A "*" wildcard cannot be
# used with cookies, so list real origins, comma-separated.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# SMTP (optional — for exception email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
UNDERWRITING_EMAIL=underwriting@demo.bank
